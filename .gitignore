```gitignore
# Dependencies
node_modules/

# Build artifacts
dist/
build/
target/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.py.class
.Python
env/
venv/
.venv/
.ENV
.env
.env.local
.env.*
.python-version
.coverage
coverage/
htmlcov/
.pytest_cache/
.mypy_cache/
.hypothesis/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by js coverage tools
coverage/

# Temporary folders
tmp/
temp/

# Environment specific settings
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
```