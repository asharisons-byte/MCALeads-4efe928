```gitignore
# Dependencies
node_modules/
.pnpm-store/
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
coverage/
.nyc_output/
.eslintcache

# Environment variables
.env
.env.local
.env.*
!.env.example

# IDE specific
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# TypeScript/JavaScript specific
*.tsbuildinfo
.next/
.nuxt/
public/dist/

# Python specific (if applicable)
__pycache__/
*.py[cod]
*$py.class
*.so
